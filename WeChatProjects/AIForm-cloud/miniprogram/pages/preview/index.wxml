<nav title-text="PDF 预览" />

<view class="preview {{isTemplatePreview ? 'preview--template' : ''}}" wx:if="{{application}}">
  <view class="summary">
    <view class="summary__info">
      <view class="summary__title">{{application.title}}</view>
      <view class="summary__meta">{{application.country}} · {{application.visaType}}</view>
    </view>
    <view wx:if="{{overflowCount > 0}}" class="summary__pending">{{overflowCount}} 项内容过长</view>
    <button wx:if="{{isTemplatePreview}}" class="summary__back" bindtap="backToHome">返回</button>
  </view>

  <scroll-view class="canvas-scroll" scroll-y>
    <!-- PDF 页面图 + 把已填写的值按 acroform 坐标叠加回原位 -->
    <view class="pdf-canvas" wx:if="{{currentPage}}">
      <image class="pdf-bg" src="{{currentPage.previewImage}}" mode="widthFix" bindload="onPreviewImageLoad" binderror="onPreviewImageError" />
      <view
        wx:for="{{currentPage.overlays}}"
        wx:key="id"
        wx:if="{{item.filled}}"
        class="overlay {{item.isCheckbox ? 'overlay--checkbox' : ''}}"
        style="{{item.style}}"
      >
        <view wx:if="{{item.isCheckbox}}" class="overlay__check" aria-label="已勾选">
          <view class="overlay__check-mark"></view>
        </view>
        <view wx:else class="overlay__clip {{item.multiline ? 'overlay__clip--multiline' : ''}}">
          <view class="overlay__content" style="{{item.valueStyle}}">
            <text
              wx:for="{{item.lineItems}}"
              wx:for-item="lineItem"
              wx:key="key"
              class="overlay__line"
            >{{lineItem.text}}</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="footer">
    <view class="page-nav">
      <text class="page-nav__btn {{pageIndex <= 0 ? 'page-nav__btn--disabled' : ''}}" bindtap="prevPage">上一页</text>
      <text class="page-nav__page">{{pageIndex + 1}} / {{pages.length}}</text>
      <text class="page-nav__btn {{pageIndex >= pages.length - 1 ? 'page-nav__btn--disabled' : ''}}" bindtap="nextPage">下一页</text>
    </view>

    <view class="footer__actions" wx:if="{{!isTemplatePreview}}">
      <button class="footer-btn footer-btn--ghost" bindtap="editForm">修改</button>
      <button
        class="footer-btn footer-btn--primary"
        disabled="{{exportProgressVisible}}"
        bindtap="exportPdf"
      >确认导出</button>
    </view>
  </view>
</view>

<view
  wx:if="{{exportProgressVisible}}"
  class="export-progress"
  catchtouchmove="preventTouchMove"
  aria-label="PDF 正在生成"
>
  <view class="export-progress__panel">
    <view class="export-progress__visual">
      <view class="export-progress__ring"></view>
      <t-icon name="file-pdf" size="46rpx" color="#0052d9" />
    </view>
    <view class="export-progress__title">
      {{exportProgressStage === 'downloading' ? '马上就好' : '飞快生成中'}}
    </view>
    <view class="export-progress__hint">
      {{exportProgressStage === 'downloading' ? 'PDF 已生成，正在打开…' : '大约 10 秒左右，请稍候'}}
    </view>
    <view class="export-progress__track" aria-role="progressbar" aria-label="导出进度 {{exportProgress}}%">
      <view class="export-progress__bar" style="{{exportProgressStyle}}"></view>
    </view>
    <view class="export-progress__percent">{{exportProgress}}%</view>
  </view>
</view>
