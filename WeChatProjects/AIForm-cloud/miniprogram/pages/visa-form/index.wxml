<nav title-text="辅助填写" />

<first-launch-notice
  wx:if="{{showFirstLaunchNotice}}"
  auto="{{false}}"
  bind:acknowledge="onFirstLaunchAcknowledge"
/>

<view wx:if="{{formReady}}" class="split" style="{{splitHeight ? 'height:' + splitHeight + 'px;' : ''}}">
  <!-- 顶部图片预览（与下方表单上下分屏），突出当前填写位置 -->
  <view class="preview-pane">
    <view class="preview-pane__head">
      <view class="preview-pane__meta">
        <view class="preview-pane__title">第 {{activePage}} 页 · {{activeFieldLabel || '点击下方字段定位'}}</view>
      </view>
      <scroll-view class="page-tabs" scroll-x>
        <view
          wx:for="{{pageTabs}}"
          wx:key="page"
          class="page-tab {{item.page === activePage ? 'page-tab--active' : ''}}"
          data-page="{{item.page}}"
          bindtap="switchPage"
        >{{item.label}}</view>
      </scroll-view>
    </view>

    <movable-area class="preview-area" scale-area>
      <movable-view
        class="preview-mover"
        direction="all"
        scale
        animation="{{false}}"
        scale-min="1"
        scale-max="3"
        scale-value="{{previewScale}}"
        x="{{previewX}}"
        y="{{previewY}}"
        bindchange="onPreviewMove"
        bindscale="onPreviewScale"
        bindtap="onPreviewTap"
        style="width:{{previewCanvasWidth}}px;height:{{previewCanvasHeight}}px;"
      >
        <view class="pdf-canvas">
          <image class="pdf-bg" src="{{previewImage}}" mode="widthFix" bindload="onPreviewImageLoad" binderror="onPreviewImageError" />
          <view
            wx:for="{{previewFields}}"
            wx:key="id"
            class="box {{item.active ? 'box--active' : (item.manual ? 'box--manual' : (item.filled ? 'box--filled' : 'box--empty'))}} {{item.isHandwriting ? 'box--handwriting' : ''}} {{item.skipFill ? 'box--skip' : ''}} {{item.isCheckbox ? 'box--checkbox' : ''}} {{item.overflow ? 'box--overflow' : ''}}"
            style="{{item.style}}"
            data-name="{{item.id}}"
            data-leaf="{{item.leafId}}"
            bindtap="tapPreviewBox"
          >
            <view wx:if="{{item.isCheckbox && item.filled}}" class="box__check" aria-label="已勾选">✓</view>
            <view wx:else class="box__clip {{item.multiline ? 'box__clip--multiline' : ''}}">
              <view class="box__content" style="{{item.valueStyle}}">
                <text
                  wx:for="{{item.lineItems}}"
                  wx:for-item="lineItem"
                  wx:key="key"
                  class="box__line"
                >{{lineItem.text}}</text>
              </view>
            </view>
          </view>
        </view>
      </movable-view>
    </movable-area>
    <view class="preview-gesture-hint">双指缩放 · 双击切换</view>
  </view>

  <scroll-view
    class="form-list"
    scroll-y
    scroll-into-view="{{formScrollIntoView}}"
    scroll-with-animation
    bindscroll="onFormScroll"
  >
    <view class="leaf-card" wx:for="{{activeFormLeaves}}" wx:for-item="leaf" wx:key="leafId" id="{{leaf.leafId}}">
      <view class="leaf-block">
        <view class="leaf-block__marker" aria-hidden="true"></view>
        <view class="leaf-block__content">
          <text class="leaf-block__eyebrow">填写项目</text>
          <text class="leaf-block__line" wx:for="{{leaf.lines}}" wx:for-item="line" wx:key="*this">{{line}}</text>
        </view>
      </view>

      <view class="leaf-manual leaf-manual--handwriting" wx:if="{{leaf.isHandwriting && leaf.fieldCount === 0}}">
        <text class="leaf-manual__icon">!</text>
        <text>需要手写</text>
      </view>

      <view class="leaf-fields" wx:elif="{{leaf.fieldCount > 0}}">
        <view class="field {{field.kind === 'checkbox' ? 'field--option' : ''}}" wx:for="{{leaf.fields}}" wx:for-item="field" wx:key="id">
          <view
            wx:if="{{field.isHandwriting}}"
            class="field-input field-input--handwriting {{activeFieldName === field.id ? 'field--active' : ''}}"
            data-name="{{field.id}}"
            bindtap="onFieldFocus"
          >
            <view class="field-input__label field-input__label--handwriting">
              <text>{{field.label}}</text>
              <text class="field-input__mode">手写</text>
            </view>
            <view class="field-input__control field-input__control--handwriting">
              <view class="field-input__handwriting-copy">
                <text class="field-input__handwriting-title">此项需要手写</text>
                <text class="field-input__handwriting-hint">请在打印后填写</text>
              </view>
            </view>
            <view class="field-input__hint {{activeFieldName === field.id ? 'field-input__hint--show' : ''}}">上方预览已显示对应的手写位置</view>
          </view>

          <view
            wx:elif="{{field.kind === 'checkbox'}}"
            class="field-checkbox {{values[field.id] ? 'field-checkbox--on' : ''}} {{activeFieldName === field.id ? 'field--active' : ''}}"
            data-name="{{field.id}}"
            bindtap="onCheckboxTap"
          >
            <view class="field-checkbox__box">{{values[field.id] ? '✓' : ''}}</view>
            <text class="field-checkbox__label">{{field.label}}</text>
          </view>

          <view wx:else class="field-input {{activeFieldName === field.id ? 'field--active' : ''}}">
            <view class="field-input__label">
              <text>{{field.label}}</text>
            </view>

            <picker
              wx:if="{{field.component === 'date'}}"
              mode="multiSelector"
              range="{{datePickerDisplayRanges[field.id]}}"
              value="{{datePickerValues[field.id]}}"
              data-name="{{field.id}}"
              bindchange="onDateChange"
              bindcolumnchange="onDateColumnChange"
              bindtap="onFieldFocus"
            >
              <view class="field-input__control field-input__control--picker">
                <text wx:if="{{values[field.id]}}">{{values[field.id]}}</text>
                <text wx:else class="field-input__placeholder">请选择日期（日-月-年）</text>
                <text class="field-input__chevron" aria-hidden="true">›</text>
              </view>
            </picker>

            <textarea
              wx:elif="{{field.component === 'textarea'}}"
              class="field-input__control field-input__control--textarea"
              value="{{values[field.id]}}"
              placeholder="请输入{{field.label}}"
              placeholder-class="field-input__placeholder"
              data-name="{{field.id}}"
              bindinput="onTextInput"
              bindfocus="onKeyboardFieldFocus"
              bindblur="onKeyboardFieldBlur"
              auto-height
            />

            <input
              wx:elif="{{field.component === 'phone'}}"
              class="field-input__control"
              value="{{values[field.id]}}"
              placeholder="请输入国家/地区代码和电话号码"
              placeholder-class="field-input__placeholder"
              data-name="{{field.id}}"
              bindinput="onTextInput"
              bindfocus="onKeyboardFieldFocus"
              bindblur="onKeyboardFieldBlur"
            />

            <input
              wx:else
              class="field-input__control"
              value="{{values[field.id]}}"
              placeholder="请输入{{field.label}}"
              placeholder-class="field-input__placeholder"
              data-name="{{field.id}}"
              bindinput="onTextInput"
              bindfocus="onKeyboardFieldFocus"
              bindblur="onKeyboardFieldBlur"
            />
            <view wx:if="{{field.component === 'phone'}}" class="field-input__example">
              <text class="field-input__example-label">示例</text>
              <text>+86 138 0000 0000 或 +86 (10) 8888 8888</text>
            </view>
            <view wx:elif="{{field.example}}" class="field-input__example">
              <text class="field-input__example-label">示例</text>
              <text>{{field.example}}</text>
            </view>
            <view class="field-input__hint {{activeFieldName === field.id ? 'field-input__hint--show' : ''}}">填写后会同步高亮到上方预览对应位置</view>
          </view>
        </view>
      </view>

      <view class="leaf-empty" wx:else>该文字块为说明文字，无需填写</view>
    </view>

    <view class="next-page" wx:if="{{hasNextPage}}">
      <button class="next-page__btn" bindtap="goNextPage">下一页 →</button>
    </view>

    <view class="form-list__pad"></view>
  </scroll-view>

  <view class="form-footer">
    <button class="footer-btn footer-btn--plain" bindtap="backToHome">返回</button>
    <button class="footer-btn footer-btn--ghost" bindtap="saveDraft">保存草稿</button>
    <button class="footer-btn footer-btn--primary" bindtap="goPreview">完成</button>
  </view>
</view>
