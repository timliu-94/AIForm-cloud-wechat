<view class="my">
  <nav title-text="我的" />

  <view class="profile-card">
    <view class="profile-card__avatar">
      <image
        class="profile-card__avatar-image"
        src="/static/icons/form-assistant-logo.png"
        mode="aspectFill"
      />
    </view>
    <view class="profile-card__body">
      <view class="profile-card__name">表小签</view>
      <view class="profile-card__slogan">您的填签助手</view>
    </view>
  </view>

  <view class="points-card">
    <view>
      <view class="points-card__label">本地表格</view>
      <view class="points-card__value">{{applicationCount}}<text>份</text></view>
    </view>
    <view class="points-card__icon">
      <t-icon name="file" size="42rpx" color="#cbd6ff" />
    </view>
  </view>

  <view class="settings-section">
    <view class="settings-section__title">帮助与反馈</view>
    <view class="action-list">
      <button
        class="action-item action-item--customer-service"
        data-type="customerService"
        bindtap="onEleClick"
      >
        <view class="action-item__main">
          <view class="action-item__icon">
            <t-icon name="chat" size="34rpx" />
          </view>
          <view>
            <view class="action-item__title">微信客服</view>
            <view class="action-item__note">问题咨询、意见建议及其他帮助</view>
          </view>
        </view>
        <t-icon name="chevron-right" size="34rpx" color="#737686" />
      </button>
    </view>
  </view>

  <view wx:if="{{showCustomerService}}" class="panel customer-service-panel">
    <view class="panel__title">微信客服</view>
    <view class="customer-service-panel__intro">
      <view class="customer-service-panel__icon">
        <t-icon name="chat" size="42rpx" color="#003da6" />
      </view>
      <view class="customer-service-panel__content">
        <view class="customer-service-panel__title">帮助与反馈</view>
        <view class="customer-service-panel__description">遇到问题或有任何意见和建议，欢迎通过微信客服联系我们。</view>
      </view>
    </view>
    <button
      class="customer-service-panel__button"
      open-type="contact"
      session-from="{{sessionFrom}}"
      bindcontact="handleContact"
    >
      <t-icon name="chat" size="32rpx" color="#ffffff" />
      <text>联系微信客服</text>
    </button>
    <view class="customer-service-panel__hint">进入客服后，请直接描述问题或告诉我们您的建议。</view>
  </view>

  <view class="settings-section">
    <view class="settings-section__title">关于</view>
    <view class="action-list">
      <button class="action-item" data-type="privacy" bindtap="onEleClick">
        <view class="action-item__main">
          <view class="action-item__icon">
            <t-icon name="lock-on" size="34rpx" />
          </view>
          <view>
            <view class="action-item__title">隐私政策</view>
            <view class="action-item__note">查看小程序隐私政策</view>
          </view>
        </view>
        <t-icon name="chevron-right" size="34rpx" color="#737686" />
      </button>
    </view>
  </view>

  <view wx:if="{{showPrivacy}}" class="panel privacy-panel">
    <view class="panel__title">{{privacyPolicy.title}}</view>
    <view class="privacy-panel__updated">更新日期：{{privacyPolicy.updatedAt}}</view>
    <view
      wx:for="{{privacyPolicy.paragraphs}}"
      wx:key="heading"
      class="privacy-panel__section"
    >
      <view class="privacy-panel__heading">{{item.heading}}</view>
      <view class="privacy-panel__text">{{item.text}}</view>
    </view>
  </view>
</view>
