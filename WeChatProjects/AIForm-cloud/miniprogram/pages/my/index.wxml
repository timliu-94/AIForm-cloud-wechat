<t-toast id="t-toast" />

<view class="my">
  <nav title-text="我的" />

  <view class="profile-card">
    <view class="profile-card__avatar">
      <t-icon name="user" size="54rpx" color="#003da6" />
    </view>
    <view class="profile-card__body">
      <view class="profile-card__name">Form Assistant User</view>
      <view class="profile-card__verified">
        <t-icon name="check-circle-filled" size="28rpx" color="#003da6" />
        <text>Verified Account</text>
      </view>
      <view class="profile-card__tier">Tier: Silver Member</view>
    </view>
  </view>

  <view class="points-card">
    <view>
      <view class="points-card__label">本地表格 (Forms)</view>
      <view class="points-card__value">{{applicationCount}}<text>份</text></view>
    </view>
    <view class="points-card__icon">
      <t-icon name="file" size="42rpx" color="#cbd6ff" />
    </view>
  </view>

  <view class="action-list">
    <button
      wx:for="{{settingList}}"
      wx:for-item="item"
      wx:key="type"
      class="action-item {{item.danger ? 'action-item--danger' : ''}}"
      data-data="{{item}}"
      bindtap="onEleClick"
    >
      <view class="action-item__main">
        <view class="action-item__icon">
          <t-icon name="{{item.icon}}" size="34rpx" />
        </view>
        <view>
          <view class="action-item__title">{{item.name}}</view>
          <view wx:if="{{item.note}}" class="action-item__note">{{item.note}}</view>
        </view>
      </view>
      <t-icon wx:if="{{item.url}}" name="chevron-right" size="34rpx" color="#737686" />
    </button>
  </view>

  <view wx:if="{{showFeedback}}" class="panel feedback-panel">
    <view class="panel__title">意见与建议</view>
    <view class="form-row">
      <view class="form-row__label">类型</view>
      <picker mode="selector" range="{{feedbackTypes}}" value="{{feedbackTypeIndex}}" bindchange="onFeedbackTypeChange">
        <view class="form-row__control form-row__control--picker">
          <text>{{feedbackTypes[feedbackTypeIndex]}}</text>
          <t-icon name="chevron-right" size="30rpx" color="#737686" />
        </view>
      </picker>
    </view>
    <view class="form-row">
      <view class="form-row__label">详细描述</view>
      <textarea
        class="feedback-panel__textarea"
        value="{{feedbackDescription}}"
        placeholder="请描述遇到的问题、使用建议或其他想法"
        maxlength="500"
        bindinput="onFeedbackInput"
      />
      <view class="feedback-panel__count">{{feedbackDescription.length}}/500</view>
    </view>
    <view class="panel__actions">
      <button class="panel-btn panel-btn--plain" bindtap="cancelFeedback">取消</button>
      <button class="panel-btn panel-btn--primary" bindtap="submitFeedback">提交</button>
    </view>
  </view>

  <view wx:if="{{showContact}}" class="panel customer-service-panel">
    <view class="panel__title">微信客服</view>
    <view class="customer-service-panel__intro">
      <view class="customer-service-panel__icon">
        <t-icon name="chat" size="42rpx" color="#003da6" />
      </view>
      <view class="customer-service-panel__content">
        <view class="customer-service-panel__title">在线客服咨询</view>
        <view class="customer-service-panel__description">如有使用问题或需要帮助，可通过微信客服与我们沟通。</view>
      </view>
    </view>
    <button
      class="customer-service-panel__button"
      open-type="contact"
      session-from="{{sessionFrom}}"
      bindcontact="handleContact"
    >
      <t-icon name="chat" size="32rpx" color="#ffffff" />
      <text>联系微信客服</text>
    </button>
    <view class="customer-service-panel__hint">发送消息后，客服人员上线时会尽快回复。</view>
  </view>

  <view wx:if="{{showPrivacy}}" class="panel privacy-panel">
    <view class="panel__title">{{privacyPolicy.title}}</view>
    <view class="privacy-panel__updated">更新日期：{{privacyPolicy.updatedAt}}</view>
    <view
      wx:for="{{privacyPolicy.paragraphs}}"
      wx:key="*this"
      class="privacy-panel__section"
    >
      <view class="privacy-panel__text">{{item}}</view>
    </view>
  </view>
</view>

<view wx:if="{{showFeedbackSuccess}}" class="feedback-success-modal" catchtouchmove="noop" bindtap="closeFeedbackSuccess">
  <view class="feedback-success-modal__panel" catchtap="noop">
    <view class="feedback-success-modal__icon">
      <t-icon name="check" size="42rpx" color="#003da6" />
    </view>
    <view class="feedback-success-modal__title">提交成功</view>
    <view class="feedback-success-modal__content">感谢你的建议，我们会认真查看并持续优化使用体验。</view>
    <button class="feedback-success-modal__button" bindtap="closeFeedbackSuccess">知道了</button>
  </view>
</view>
