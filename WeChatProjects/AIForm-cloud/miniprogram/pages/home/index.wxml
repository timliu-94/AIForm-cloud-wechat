<nav title-text="签证申请表辅助填写" />

<view class="home">
  <view class="hero">
    <view class="hero__label">
      <t-icon class="hero__label-icon" name="/static/icons/ai-tool.svg" size="26rpx" color="#0052d9" />
      <text>Smart Visa Form</text>
    </view>
    <view class="hero__title">签证申请表辅助填写</view>
    <view class="hero__desc">选择目的地和签证类型，系统将引导你完成申请表填写并生成表格文件。</view>
  </view>

  <view class="section section--destination">
    <view class="section__header">
      <view class="section__heading">
        <view class="section__step {{selectedCountry ? 'section__step--completed' : ''}}">1</view>
        <view class="section__title">第一步：选择目的地</view>
      </view>
      <view class="section__hint">共 {{countries.length}} 个国家</view>
    </view>

    <view class="search-wrap">
      <view class="search">
        <t-icon name="search" size="36rpx" color="#434654" />
        <input placeholder="搜索国家/地区" value="{{query}}" bindinput="onSearch" />
      </view>
      <view class="search-empty" wx:if="{{!countries.length}}">
        <view class="search-empty__icon">
          <t-icon name="chat" size="32rpx" color="#003da6" />
        </view>
        <view class="search-empty__body">
          <view class="search-empty__title">没有找到国家，请联系我们</view>
          <view class="search-empty__desc">通过微信客服告诉我们你需要的国家/地区。</view>
        </view>
        <button class="search-empty__button" bindtap="openCustomerService">联系客服</button>
      </view>
    </view>

    <scroll-view class="continent-row" scroll-x show-scrollbar="{{false}}">
      <view class="continent-row__inner">
        <view
          wx:for="{{destinationFilters}}"
          wx:key="*this"
          class="continent {{selectedContinent === item ? 'continent--active' : ''}}"
          data-name="{{item}}"
          bindtap="selectContinent"
        >
          <t-icon
            wx:if="{{item === hotFilter}}"
            class="continent__hot-icon"
            name="filter-3"
            size="28rpx"
            color="{{selectedContinent === item ? '#ffffff' : '#434654'}}"
          />
          <text>{{item}}</text>
        </view>
      </view>
    </scroll-view>

    <view class="country-list">
      <view
        wx:for="{{countries}}"
        wx:key="id"
        class="country-item {{selectedCountryId === item.id ? 'country-item--active' : ''}}"
        data-id="{{item.id}}"
        bindtap="selectCountry"
      >
        <view wx:if="{{item.flag}}" class="country-item__flag">
          <image class="country-item__flag-image" src="{{item.flag}}" mode="aspectFill" />
          <view class="country-item__flag-wave country-item__flag-wave--front"></view>
          <view class="country-item__flag-wave country-item__flag-wave--back"></view>
        </view>
        <view wx:else class="country-item__fallback">{{item.flagLabel}}</view>
        <view class="country-item__body">
          <view class="country-item__name">{{item.name}}</view>
          <view class="country-item__meta">
            <text class="country-item__tag">{{item.continent}}</text>
            <text>{{item.visaTypes.length}} 类申请表</text>
          </view>
        </view>
        <view class="country-item__radio radio {{selectedCountryId === item.id ? 'radio--active' : ''}}"></view>
      </view>
    </view>
  </view>

  <view class="section {{!selectedCountry ? 'section--collapsed' : ''}}">
    <view class="section__header">
      <view class="section__heading">
        <view class="section__step {{selectedVisaType ? 'section__step--completed' : ''}}">2</view>
        <view class="section__title">第二步：选择签证类型</view>
      </view>
      <view class="section__pill" wx:if="{{selectedCountry}}">{{selectedCountry.name}}</view>
      <view class="section__locked" wx:else>请先完成第一步</view>
    </view>
    <view class="option-grid" wx:if="{{selectedCountry}}">
      <view
        wx:for="{{selectedCountry.visaTypes}}"
        wx:key="id"
        class="option {{selectedVisaTypeId === item.id ? 'option--active' : ''}}"
        data-id="{{item.id}}"
        bindtap="selectVisaType"
      >
        <t-icon name="{{item.icon}}" size="44rpx" color="{{selectedVisaTypeId === item.id ? '#0052d9' : '#737686'}}" />
        <view class="option__name">{{item.name}}</view>
      </view>
    </view>
  </view>

  <view class="section {{!selectedVisaType ? 'section--collapsed' : ''}}">
    <view class="section__header">
      <view class="section__heading">
        <view class="section__step {{selectedVersion ? 'section__step--completed' : ''}}">3</view>
        <view class="section__title">第三步：确认申请表</view>
      </view>
      <view class="section__pill" wx:if="{{selectedVisaType}}">{{selectedVisaType.name}}</view>
      <view class="section__locked" wx:else>请先完成第二步</view>
    </view>
    <block wx:if="{{selectedVisaType && selectedDistrict}}">
      <view class="section__hint section__status" wx:if="{{catalogLoading}}">正在读取云存储申请表…</view>
      <view class="section__hint section__status" wx:if="{{catalogError}}">云目录读取失败，当前显示缓存配置</view>
      <view
        wx:for="{{selectedDistrict.versions}}"
        wx:key="id"
        class="version {{selectedVersionId === item.id ? 'version--active' : ''}}"
        data-id="{{item.id}}"
        bindtap="selectVersion"
      >
        <view class="version__badge" wx:if="{{index === 0}}">推荐</view>
        <view class="radio {{selectedVersionId === item.id ? 'radio--active' : ''}}"></view>
        <view class="version__body">
          <view class="version__name">{{item.name}}</view>
          <view class="version__meta">版本: {{item.version}} | 更新于: {{item.publishedAt}}</view>
          <view class="version__scope">{{item.scope}}</view>
          <view class="version__scope" wx:if="{{item.availableForFill === false}}">仅可查看 PDF，填写资源不完整</view>
        </view>
        <button class="version__preview" data-id="{{item.id}}" catchtap="previewVersion">
          <t-icon name="browse" size="26rpx" color="#0052d9" />
          <text>预览</text>
        </button>
      </view>
    </block>
  </view>

</view>

<view class="action-bar">
  <button
    class="action-bar__button {{!selectedCountry || !selectedVisaType || !selectedVersion || selectedVersion.availableForFill === false ? 'action-bar__button--disabled' : ''}}"
    bindtap="startSelectedMode"
    aria-disabled="{{!selectedCountry || !selectedVisaType || !selectedVersion || selectedVersion.availableForFill === false}}"
  >
    开始填写
  </button>
</view>

<first-launch-notice />
