<nav title-text="我的表格" />

<scroll-view class="applications" scroll-y>
  <view class="page-head">
    <view class="page-head__title">我的表格</view>
    <view class="page-head__tabs">
      <view class="page-head__tab page-head__tab--active">全部</view>
      <view class="page-head__tab">草稿</view>
      <view class="page-head__tab">已完成</view>
    </view>
  </view>

  <view class="search-panel" wx:if="{{totalCount > 0}}">
    <view class="search-panel__box">
      <t-icon name="search" size="30rpx" color="#737686" />
      <input
        class="search-panel__input"
        value="{{searchKeyword}}"
        placeholder="按标题搜索"
        placeholder-class="search-panel__placeholder"
        confirm-type="search"
        bindinput="onSearchInput"
      />
      <button wx:if="{{searchKeyword}}" class="search-panel__clear" bindtap="clearSearch" aria-label="清空搜索">
        <t-icon name="close-circle" size="30rpx" color="#737686" />
      </button>
    </view>
  </view>

  <view class="empty" wx:if="{{totalCount === 0}}">
    <t-icon name="file" size="72rpx" color="#94a3b8" />
    <view class="empty__title">暂无表格</view>
    <view class="empty__desc">从首页选择国家和表格用途后开始辅助填写。</view>
  </view>

  <view class="empty" wx:elif="{{applications.length === 0}}">
    <t-icon name="search" size="72rpx" color="#94a3b8" />
    <view class="empty__title">没有匹配的表格</view>
    <view class="empty__desc">换个标题关键词再试。</view>
  </view>

  <view
    wx:for="{{applications}}"
    wx:key="id"
    class="application-card {{item.selected ? 'application-card--selected' : ''}}"
  >
    <view class="application-card__head">
      <view class="application-card__main">
        <button class="application-card__select" data-id="{{item.id}}" catchtap="toggleSelectApplication" aria-label="选择表格">
          <view class="select-box {{item.selected ? 'select-box--checked' : ''}}">
            <t-icon wx:if="{{item.selected}}" name="check" size="24rpx" color="#ffffff" />
          </view>
        </button>
        <view class="application-card__flag">
          <image wx:if="{{item.countryFlag}}" class="application-card__flag-image" src="{{item.countryFlag}}" mode="aspectFill" />
          <view wx:else class="application-card__flag-fallback">{{item.countryFlagLabel}}</view>
        </view>
        <view class="application-card__content">
          <view class="application-card__title-row" data-index="{{index}}" bindtap="renameApplication">
            <view class="application-card__title">{{item.title}}</view>
            <t-icon name="edit-1" size="28rpx" color="#737686" />
          </view>
          <view class="application-card__meta">{{item.formVersionTitle}}</view>
        </view>
      </view>
      <view class="application-card__side">
        <view class="status {{item.status === 'draft' ? 'status--draft' : 'status--done'}}">{{item.status === 'draft' ? '草稿' : '已完成'}}</view>
        <button class="application-card__delete" data-index="{{index}}" bindtap="deleteApplication" aria-label="删除">
          <t-icon name="delete" size="28rpx" color="#ba1a1a" />
        </button>
      </view>
    </view>
    <view class="application-card__info">
      <t-icon name="time" size="28rpx" color="#737686" />
      <text>表格版本 {{item.version}} · 更新 {{item.displayUpdatedAt}}</text>
    </view>
    <view class="application-card__actions">
      <button data-index="{{index}}" bindtap="previewApplication">
        <t-icon name="browse" size="30rpx" />
        <text>预览</text>
      </button>
      <button data-index="{{index}}" bindtap="editApplication">
        <t-icon name="edit" size="30rpx" />
        <text>修改</text>
      </button>
      <button data-index="{{index}}" bindtap="copyForCompanion">
        <t-icon name="copy" size="30rpx" />
        <text>为同行人创建</text>
      </button>
      <button data-index="{{index}}" bindtap="openShareFill">
        <t-icon name="share" size="30rpx" />
        <text>分享填写</text>
      </button>
      <button data-index="{{index}}" disabled="{{exportProgressVisible}}" bindtap="exportApplication">
        <t-icon name="download" size="30rpx" />
        <text>导出</text>
      </button>
    </view>
  </view>

  <view class="bulk-bar" wx:if="{{totalCount > 0}}">
    <button class="bulk-bar__select" disabled="{{applications.length === 0}}" bindtap="toggleSelectAll">
      <view class="select-box {{allSelected ? 'select-box--checked' : ''}}">
        <t-icon wx:if="{{allSelected}}" name="check" size="24rpx" color="#ffffff" />
      </view>
      <text>全选</text>
    </button>
    <view class="bulk-bar__count">
      <text wx:if="{{selectedCount > 0}}">已选择 {{selectedCount}} 项</text>
      <text wx:elif="{{searchKeyword}}">匹配 {{filteredCount}} / {{totalCount}} 份</text>
      <text wx:else>共 {{totalCount}} 份表格</text>
    </view>
    <button
      class="bulk-bar__delete {{selectedCount > 0 ? 'bulk-bar__delete--active' : ''}}"
      disabled="{{selectedCount === 0}}"
      bindtap="deleteSelectedApplications"
    >删除</button>
  </view>
</scroll-view>

<view wx:if="{{companionDialogVisible}}" class="companion-dialog" catchtap="closeCompanionDialog">
  <view class="companion-dialog__panel tool-dialog" catchtap="stopCompanionDialogTap">
    <view class="tool-dialog__head">
      <view class="tool-dialog__identity">
        <view class="tool-dialog__icon">
          <t-icon name="copy" size="34rpx" color="#0052d9" />
        </view>
        <view class="tool-dialog__heading">
          <view class="tool-dialog__eyebrow">同行人代填工具</view>
          <view class="tool-dialog__title">为同行人创建</view>
        </view>
      </view>
      <button class="tool-dialog__close" bindtap="closeCompanionDialog" aria-label="关闭">
        <t-icon name="close" size="32rpx" color="#434654" />
      </button>
    </view>

    <scroll-view class="tool-dialog__content" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="tool-purpose tool-purpose--companion">
        <view class="tool-purpose__icon">
          <t-icon name="usergroup-add" size="34rpx" color="#0052d9" />
        </view>
        <view class="tool-purpose__body">
          <view class="tool-purpose__title">复用签证信息，快速创建新表格</view>
          <view class="tool-purpose__desc">适合你帮家人或朋友填写。新表格创建后，由你继续完善和管理。</view>
        </view>
      </view>

      <view class="tool-source">
        <view class="tool-source__icon">
          <t-icon name="file" size="30rpx" color="#0052d9" />
        </view>
        <view class="tool-source__body">
          <view class="tool-source__label">复用信息来源</view>
          <view class="tool-source__title">{{companionSourceTitle}}</view>
        </view>
        <view class="tool-source__tag">当前表格</view>
      </view>

      <view class="tool-section">
        <view class="tool-section__head">
          <view class="tool-section__heading">
            <view>
              <view class="tool-section__title">选择要带入的内容</view>
              <view class="tool-section__desc">已选 {{companionSelectedCount}} / {{companionFields.length}} 项</view>
            </view>
          </view>
          <button class="tool-select-all" bindtap="toggleCompanionAll">
            <view class="select-box {{companionAllSelected ? 'select-box--checked' : ''}}">
              <t-icon wx:if="{{companionAllSelected}}" name="check" size="24rpx" color="#ffffff" />
            </view>
            <text>{{companionAllSelected ? '取消全选' : '全选'}}</text>
          </button>
        </view>

        <view class="tool-tip">
          <t-icon name="secured" size="27rpx" color="#737686" />
          <text>{{companionSelectionTip}}</text>
        </view>

        <view class="tool-field-list">
          <button
            wx:for="{{companionFields}}"
            wx:key="name"
            class="tool-field {{item.selected ? 'tool-field--selected' : ''}}"
            data-name="{{item.name}}"
            bindtap="toggleCompanionField"
          >
            <view class="select-box {{item.selected ? 'select-box--checked' : ''}}">
              <t-icon wx:if="{{item.selected}}" name="check" size="24rpx" color="#ffffff" />
            </view>
            <text>{{item.title}}</text>
          </button>
        </view>
      </view>
    </scroll-view>

    <view class="tool-dialog__footer">
      <view class="tool-dialog__result">
        <view class="tool-dialog__result-label">新表格</view>
        <view class="tool-dialog__result-text">创建后由你继续填写</view>
      </view>
      <view class="tool-dialog__actions">
        <button class="tool-dialog__secondary" bindtap="closeCompanionDialog">取消</button>
        <button
          class="tool-dialog__primary"
          disabled="{{companionSelectedCount === 0}}"
          bindtap="createCompanionApplication"
        >创建新表格</button>
      </view>
    </view>
  </view>
</view>

<view
  wx:if="{{inviteDialogVisible}}"
  class="companion-dialog companion-dialog--invite"
  catchtap="closeInviteDialog"
>
  <view
    class="companion-dialog__panel companion-dialog__panel--invite tool-dialog"
    catchtap="stopCompanionDialogTap"
  >
    <view class="tool-dialog__head">
      <view class="tool-dialog__identity">
        <view class="tool-dialog__icon">
          <t-icon name="share" size="34rpx" color="#0052d9" />
        </view>
        <view class="tool-dialog__heading">
          <view class="tool-dialog__eyebrow">邀请他人填写</view>
          <view class="tool-dialog__title">分享填写</view>
        </view>
      </view>
      <button class="tool-dialog__close" bindtap="closeInviteDialog" aria-label="关闭">
        <t-icon name="close" size="32rpx" color="#434654" />
      </button>
    </view>

    <scroll-view
      class="invite-dialog__content"
      scroll-y
      enhanced
      show-scrollbar="{{false}}"
    >
      <view class="tool-purpose tool-purpose--share">
        <view class="tool-purpose__icon">
          <t-icon name="share" size="34rpx" color="#0052d9" />
        </view>
        <view class="tool-purpose__body">
          <view class="tool-purpose__title">分享可复用信息，让对方自己填写</view>
          <view class="tool-purpose__desc">你选择要分享的信息，对方收到后在自己的微信中继续完成签证表格。</view>
        </view>
      </view>

      <view class="tool-source">
        <view class="tool-source__icon">
          <t-icon name="file" size="30rpx" color="#0052d9" />
        </view>
        <view class="tool-source__body">
          <view class="tool-source__label">分享信息来源</view>
          <view class="tool-source__title">{{inviteSourceTitle}}</view>
        </view>
        <view class="tool-source__tag">当前表格</view>
      </view>

      <view class="tool-section">
        <view class="tool-section__heading">
          <view class="tool-step">1</view>
          <view>
            <view class="tool-section__title">选择如何分享</view>
            <view class="tool-section__desc">决定是否把已有信息分享给对方</view>
          </view>
        </view>
        <view class="invite-modes">
          <button
            class="invite-mode {{inviteMode === 'blank' ? 'invite-mode--active' : ''}}"
            data-mode="blank"
            bindtap="selectInviteMode"
          >
            <view class="invite-mode__icon">
              <t-icon name="file" size="31rpx" color="{{inviteMode === 'blank' ? '#0052d9' : '#737686'}}" />
            </view>
            <view class="invite-mode__body">
              <view class="invite-mode__name">不分享已有信息</view>
              <view class="invite-mode__desc">对方从空白签证表格开始填写</view>
            </view>
            <view class="radio {{inviteMode === 'blank' ? 'radio--active' : ''}}"></view>
          </button>
          <button
            class="invite-mode {{inviteMode === 'content' ? 'invite-mode--active' : ''}}"
            data-mode="content"
            bindtap="selectInviteMode"
          >
            <view class="invite-mode__icon">
              <t-icon name="copy" size="31rpx" color="{{inviteMode === 'content' ? '#0052d9' : '#737686'}}" />
            </view>
            <view class="invite-mode__body">
              <view class="invite-mode__name">分享可复用信息</view>
              <view class="invite-mode__desc">对方收到所选信息后继续填写</view>
            </view>
            <view class="radio {{inviteMode === 'content' ? 'radio--active' : ''}}"></view>
          </button>
        </view>
      </view>

      <view wx:if="{{inviteMode === 'content'}}" class="tool-section tool-section--fields">
        <view class="tool-section__head">
          <view class="tool-section__heading">
            <view class="tool-step">2</view>
            <view>
              <view class="tool-section__title">选择要分享的信息</view>
              <view class="tool-section__desc">已选 {{inviteSelectedCount}} / {{inviteFields.length}} 项</view>
            </view>
          </view>
          <button class="tool-select-all" bindtap="toggleInviteAll">
            <view class="select-box {{inviteAllSelected ? 'select-box--checked' : ''}}">
              <t-icon wx:if="{{inviteAllSelected}}" name="check" size="24rpx" color="#ffffff" />
            </view>
            <text>{{inviteAllSelected ? '取消全选' : '全选'}}</text>
          </button>
        </view>

        <view class="tool-tip">
          <t-icon name="secured" size="27rpx" color="#737686" />
          <text>{{inviteSelectionTip}}</text>
        </view>

        <view wx:if="{{inviteFields.length > 0}}" class="tool-field-list">
          <button
            wx:for="{{inviteFields}}"
            wx:key="name"
            class="tool-field {{item.selected ? 'tool-field--selected' : ''}}"
            data-name="{{item.name}}"
            bindtap="toggleInviteField"
          >
            <view class="select-box {{item.selected ? 'select-box--checked' : ''}}">
              <t-icon wx:if="{{item.selected}}" name="check" size="24rpx" color="#ffffff" />
            </view>
            <text>{{item.title}}</text>
          </button>
        </view>
        <view wx:if="{{inviteFields.length === 0}}" class="tool-fields-empty">
          当前表格没有可分享的内容项
        </view>
      </view>

      <view class="invite-privacy">
        <t-icon name="secured" size="28rpx" color="#737686" />
        <text>对方会在自己的微信中填写；对方填写的新内容不会回传给你。</text>
      </view>
    </scroll-view>

    <view class="tool-dialog__footer tool-dialog__footer--invite">
      <view class="tool-dialog__result">
        <view class="tool-dialog__result-label">分享配置</view>
        <view class="tool-dialog__result-text" wx:if="{{inviteMode === 'blank'}}">对方从空白表格填写</view>
        <view class="tool-dialog__result-text" wx:elif="{{inviteMode === 'content'}}">分享 {{inviteSelectedCount}} 项信息</view>
        <view class="tool-dialog__result-text" wx:else>请选择一种分享方式</view>
      </view>
      <view class="tool-dialog__actions">
        <button class="tool-dialog__secondary" bindtap="closeInviteDialog">取消</button>
        <button
          class="tool-dialog__primary"
          open-type="share"
          data-share-type="invite"
          loading="{{inviteCreating}}"
          disabled="{{!inviteMode || inviteCreating || (inviteMode === 'content' && inviteSelectedCount === 0)}}"
        >
          <text>确认</text>
        </button>
      </view>
    </view>
  </view>
</view>

<view
  wx:if="{{exportProgressVisible}}"
  class="export-progress"
  catchtouchmove="preventTouchMove"
  aria-label="PDF 正在生成"
>
  <view class="export-progress__panel">
    <view class="export-progress__visual">
      <view class="export-progress__ring"></view>
      <t-icon name="file-pdf" size="46rpx" color="#0052d9" />
    </view>
    <view class="export-progress__title">
      {{exportProgressStage === 'downloading' ? '马上就好' : '飞快生成中'}}
    </view>
    <view class="export-progress__hint">
      {{exportProgressStage === 'downloading' ? 'PDF 已生成，正在打开…' : '大约 10 秒左右，请稍候'}}
    </view>
    <view class="export-progress__track" aria-role="progressbar" aria-label="导出进度 {{exportProgress}}%">
      <view class="export-progress__bar" style="{{exportProgressStyle}}"></view>
    </view>
    <view class="export-progress__percent">{{exportProgress}}%</view>
  </view>
</view>

<view
  wx:if="{{shareFillNoticeVisible}}"
  class="share-notice"
  catchtap="cancelShareFillNotice"
>
  <view class="share-notice__panel" catchtap="stopCompanionDialogTap">
    <view class="share-notice__head">
      <view class="share-notice__icon">
        <t-icon name="share" size="36rpx" color="#0052d9" />
      </view>
      <view class="share-notice__heading">
        <view class="share-notice__eyebrow">使用前说明</view>
        <view class="share-notice__title">{{shareFillNotice.title}}</view>
      </view>
      <button class="share-notice__close" bindtap="cancelShareFillNotice" aria-label="关闭">
        <t-icon name="close" size="30rpx" color="#434654" />
      </button>
    </view>
    <scroll-view class="share-notice__body" scroll-y enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{shareFillNotice.paragraphs}}"
        wx:key="*this"
        class="share-notice__paragraph"
      >
        <view class="share-notice__number">{{index + 1}}</view>
        <text>{{item}}</text>
      </view>
    </scroll-view>
    <view class="share-notice__footer">
      <button class="share-notice__remind" bindtap="toggleShareFillRemind">
        <view class="select-box {{shareFillDontRemind ? 'select-box--checked' : ''}}">
          <t-icon wx:if="{{shareFillDontRemind}}" name="check" size="24rpx" color="#ffffff" />
        </view>
        <text>{{shareFillNotice.remindText}}</text>
      </button>
      <view class="share-notice__actions">
        <button class="share-notice__cancel" bindtap="cancelShareFillNotice">取消</button>
        <button class="share-notice__confirm" bindtap="confirmShareFillNotice">{{shareFillNotice.confirmText}}</button>
      </view>
    </view>
  </view>
</view>

<view wx:if="{{companionNoticeVisible}}" class="share-notice" catchtap="cancelCompanionNotice">
  <view class="share-notice__panel" catchtap="stopCompanionDialogTap">
    <view class="share-notice__head">
      <view class="share-notice__icon">
        <t-icon name="copy" size="36rpx" color="#0052d9" />
      </view>
      <view class="share-notice__heading">
        <view class="share-notice__eyebrow">使用前说明</view>
        <view class="share-notice__title">{{companionCreateNotice.title}}</view>
      </view>
      <button class="share-notice__close" bindtap="cancelCompanionNotice" aria-label="关闭">
        <t-icon name="close" size="30rpx" color="#434654" />
      </button>
    </view>
    <scroll-view class="share-notice__body" scroll-y enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{companionCreateNotice.paragraphs}}"
        wx:key="*this"
        class="share-notice__paragraph"
      >
        <view class="share-notice__number">{{index + 1}}</view>
        <text>{{item}}</text>
      </view>
    </scroll-view>
    <view class="share-notice__footer">
      <button class="share-notice__remind" bindtap="toggleCompanionRemind">
        <view class="select-box {{companionDontRemind ? 'select-box--checked' : ''}}">
          <t-icon wx:if="{{companionDontRemind}}" name="check" size="24rpx" color="#ffffff" />
        </view>
        <text>{{companionCreateNotice.remindText}}</text>
      </button>
      <view class="share-notice__actions">
        <button class="share-notice__cancel" bindtap="cancelCompanionNotice">取消</button>
        <button class="share-notice__confirm" bindtap="confirmCompanionNotice">{{companionCreateNotice.confirmText}}</button>
      </view>
    </view>
  </view>
</view>
